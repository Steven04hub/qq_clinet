# NapCat WebSocket Server must listen on loopback and have token authentication enabled.
NAPCAT_WS_URL=ws://127.0.0.1:3001
# Replace this placeholder with the same strong token configured in NapCat.
NAPCAT_ACCESS_TOKEN=change-me

# Comma-separated positive IDs. Blank means no groups/admins are allowed.
ALLOWED_GROUP_IDS=
ADMIN_QQ_IDS=

# AI replies require your own provider API key. Never commit it.
# These three fields may be blank for listen, echo, and send commands.
# DeepSeek example; HTTPS URLs for other OpenAI-compatible providers also work.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Request timeout includes the complete model request; token output cap is 1..32768.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1024
# DeepSeek: disabled/enabled. Leave blank for providers without this option.
LLM_THINKING=disabled

# Project-local key shared by two independent Jev uses; never a global setting.
# Private participation decisions (chat mode): never publish their scores to QQ.
# off: no automatic Jev decisions; explicit user decision requests still work.
# shadow: compare privately without suppressing replies.
# gate: Jev may skip clear no-reply rounds; uncertainty/errors fall back to the LLM.
# Public tool: understands requests containing Jev without @, or /jev questions.
# It answers users' yes/no or 2..8-choice questions, not the private reply gate.
# Incomplete requests are clarified; same-user follow-ups last 3 minutes.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_MODE=off
JEV_TIMEOUT_SECONDS=3
# Bound incoming question length and waiting time for a group's turn.
MAX_INPUT_CHARS=4000
GROUP_QUEUE_TIMEOUT_SECONDS=30
# Optional: omit SYSTEM_PROMPT to keep the built-in concise Chinese group-chat prompt.
# The default prompt honestly states that the bot has no web or local-computer tools.
# SYSTEM_PROMPT="Your own nonempty system prompt"

# At least 2 messages so a complete user/assistant turn can be retained.
MAX_CONTEXT_MESSAGES=20
# On an unprofiled target group, import available NapCat history and build profiles once.
# Later updates use locally recorded new messages. Set false to use manual import only.
PROFILE_AUTO_IMPORT=true
MAX_LLM_CONCURRENCY=3
USER_RATE_LIMIT_SECONDS=5
MAX_REPLY_CHARS=1500

ACTION_TIMEOUT_SECONDS=10
CONNECT_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
